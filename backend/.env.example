# MCP Guardian backend configuration (all optional - sensible defaults apply).
# Copy to `.env` and adjust. Prefix every variable with GUARDIAN_.

GUARDIAN_ENVIRONMENT=development
GUARDIAN_DEBUG=true

# Security - CHANGE THIS IN PRODUCTION
GUARDIAN_JWT_SECRET=change-me-to-a-long-random-secret
GUARDIAN_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Redis (optional - omit to use the in-memory ring buffer)
# GUARDIAN_REDIS_URL=redis://localhost:6379/0

# Verdict thresholds (0–100)
GUARDIAN_THRESHOLD_SANITIZE=25
GUARDIAN_THRESHOLD_QUARANTINE=50
GUARDIAN_THRESHOLD_BLOCK=75

# --- LLM (optional but recommended for the chat demo) ---
# With a Groq key the chat assistant streams real LLM replies AND the hybrid
# detection tier turns on (a semantic classifier that catches novel attacks the
# heuristics miss). Without a key everything still works: replies are composed
# deterministically and detection runs heuristics-only. Get a free key at
# https://console.groq.com  →  paste it here (this file is gitignored as .env).
# GUARDIAN_GROQ_API_KEY=gsk_...
# GUARDIAN_GROQ_MODEL=llama-3.3-70b-versatile
# GUARDIAN_OLLAMA_URL=http://localhost:11434
# GUARDIAN_OLLAMA_MODEL=llama3.1

# Hybrid detection: escalate inconclusive heuristic verdicts to the LLM
# classifier for a semantic second opinion (requires GUARDIAN_GROQ_API_KEY).
# Set to false to keep detection heuristics-only (sub-millisecond, deterministic).
GUARDIAN_LLM_DETECTION_ENABLED=true

# Traffic simulator (feeds the SOC dashboard with synthetic fleet traffic so it
# looks alive during a demo; the chat's live rail is unaffected by this).
GUARDIAN_SIMULATOR_ENABLED=true
